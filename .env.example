# Copy to .env and fill in. Never commit .env.

# Which assessor to use: offline | gemini | azure_openai
GXP_PROVIDER=offline

# Gemini (Google AI Studio key)
GEMINI_API_KEY=
# Free tier: flash-lite ~500 requests/day; gemini-3.6-flash only ~20 (see docs/WORKLOG.md W14)
GEMINI_MODEL=gemini-3.5-flash-lite

# Azure OpenAI / AI Foundry
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Retrieval: fastembed | none (TF-IDF only)
GXP_EMBEDDINGS=fastembed
